# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_URL: Optional external backend base URL for client API layer.
VITE_API_URL=""

# Security & Encryption
JWT_SECRET="replace-with-strong-random-jwt-secret"
PII_ENCRYPTION_KEY="replace-with-32byte-hex-encryption-key"
CORS_ORIGIN=""

# Optional Redis URL (falls back to in-memory cache when omitted)
REDIS_URL=""

# Cloud SQL PostgreSQL connection parameters (Object Method)
SQL_HOST="127.0.0.1"
SQL_USER="app_user"
SQL_PASSWORD="change_me"
SQL_DB_NAME="sahayyatra"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change_me"
